[4782.2935, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[4782.294055, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[5d"]
[4782.294556, "o", "\u001b(B\u001b[0;1m\u001b[31m# Declare template environment\r\u001b[6d"]
[4782.295007, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[7d"]
[4782.295461, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):\r\u001b[8d"]
[4782.295959, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\" get_interface_speed returns the default Mbps value for a given\r\u001b[9d"]
[4782.296379, "o", "network interface by looking for certain keywords in the name\r\u001b[10d"]
[4782.296755, "o", "\"\"\"\r\u001b[11d"]
[4782.297198, "o", "\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[12d"]
[4782.29764, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\r\u001b[13d"]
[4782.298079, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\r\u001b[14d"]
[4782.298493, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\r\u001b[15d"]
[4782.298929, "o", "\u001b(B\u001b[0;1m\u001b[31m# Filters are added to the ENV object after declaration. Note that we're\r\u001b[16d"]
[4782.299332, "o", "# actually passing in our \"get_interface_speed\" function and not running\r\u001b[17d"]
[4782.299775, "o", "# it--the template engine will execute this function when we call\r\u001b[18d"]
[4782.300161, "o", "# template.render()\r\u001b[19d"]
[4782.300608, "o", "\u001b[39m\u001b(B\u001b[mENV.filters[\u001b(B\u001b[0;1m\u001b[32m'get_interface_speed'\u001b[39m\u001b(B\u001b[m] = get_interface_speed\r\u001b[20d"]
[4782.301003, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task8.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[21d"]
[4782.301462, "o", "\u001b(B\u001b[0;1m\u001b[31m# We load our YAML file and pass it in to the template when rendering it.\r\u001b[22d"]
[4782.301869, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"data-task7.yml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\r\u001b[23d"]
[4782.30231, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\u001b[24d"]
