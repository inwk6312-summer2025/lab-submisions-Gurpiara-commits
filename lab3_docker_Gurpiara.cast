[1116.792752, "o", "\u001b[?25l\u0007\u0007\u0007\u0007\u0007\u0007\u0007\u0007\u001b[H\u001b(B\u001b[0;7m  GNU nano 4.8                                         New Buffer                                                   \u001b[56;1H\u001b(B\u001b[m\u001b[K\u001b[1;115H\u001b[56;34H\u001b(B\u001b[0;7m[ Welcome to nano.  For basic help, type Ctrl+G. ]\u001b(B\u001b[m\r\u001b[57d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;18H\u001b(B\u001b[0;7mR\u001b(B\u001b[m Read File    \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[49G\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d\u001b[1;107H\u001b[39;49m\u001b(B\u001b[0;7mModified\r\u001b[56d\u001b(B\u001b[m\u001b[K\u001b[1;115H\r\u001b[2dja2 import Environment, FileSystemLoader\r\u001b[3dENV = Environment(loader=FileSystemLoader('.'))\r\u001b[4d\u001b[?12l\u001b[?25h"]
[1116.79392, "o", "\u001b[?25l"]
