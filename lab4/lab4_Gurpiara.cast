[7620.551783, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[7620.553465, "o", "\u001b[2d"]
[7620.553881, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[7620.55428, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[7620.554788, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[5d"]
[7620.555173, "o", "hosts = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'hosts.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[6d"]
[7620.555645, "o", "interfaces = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'interfaces.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[7d"]
[7620.556044, "o", "env = Environment(loader = FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m), trim_blocks=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\r\u001b[8d"]
[7620.556457, "o", "autoescape=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\r\u001b[9d"]
[7620.556815, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7620.557177, "o", "loopback_config = template.render(data=interfaces)\r\u001b[11d"]
[7620.55747, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m host \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m hosts[\u001b(B\u001b[0;1m\u001b[32m\"hosts\"\u001b[39m\u001b(B\u001b[m]:\u001b[12;9H"]
[7620.5578, "o", "net_connect = Netmiko(host = host[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m],\u001b[13;30H"]
[7620.558118, "o", "username = host[\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m],\u001b[14;30H"]
[7620.558451, "o", "password = host[\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m],\u001b[15;30H"]
[7620.558815, "o", "port = host[\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m],\u001b[16;30H"]
[7620.559176, "o", "device_type = host[\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m])\u001b[17;9H"]
[7620.559527, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Logged into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\u001b[18;9H"]
[7620.559925, "o", "output = net_connect.send_config_set(loopback_config.split(\u001b(B\u001b[0;1m\u001b[32m\"\\n\"\u001b[39m\u001b(B\u001b[m))\u001b[19;9H"]
[7620.560314, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Pushed config into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\u001b[20;9H"]
[7620.56072, "o", "net_connect.disconnect()\r\u001b[21d"]
