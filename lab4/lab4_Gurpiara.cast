[6662.316421, "o", "devices = [{\u001b(B\u001b[0;1m\u001b[32m\"device_type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"cisco_ios\"\u001b[39m\u001b(B\u001b[m,\u001b[4;9H"]
