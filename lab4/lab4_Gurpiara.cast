[7503.901934, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[7503.902401, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[7503.902841, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[56d"]
[7503.903285, "o", "\u001b[K\u001b[5d"]
[7503.903726, "o", "\u001b[?12l\u001b[?25h"]
[7511.305935, "o", "\u001b[?25lhosts = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'hosts.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[6dinterfaces = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'interfaces.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[7d\u001b[?12l\u001b[?25h"]
[7511.307681, "o", "\u001b[?25l"]
[7511.317486, "o", "env = Environment(loader = FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m), trim_blocks=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\r\u001b[8d"]
[7511.31808, "o", "autoescape=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\r\u001b[9d"]
[7511.318493, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7511.318945, "o", "loopback_config = template.render(data=interfaces)\r\u001b[11d"]
[7511.31937, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m host \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m hosts[\u001b(B\u001b[0;1m\u001b[32m\"hosts\"\u001b[39m\u001b(B\u001b[m]:\r\u001b[12d"]
[7511.319878, "o", "net_connect = Netmiko(host = host[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m],\r\u001b[13d"]
[7511.320375, "o", "username = host[\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m],\r\u001b[14d"]
[7511.320761, "o", "password = host[\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m],\r\u001b[15d"]
[7511.321166, "o", "port = host[\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m],\r\u001b[16d"]
[7511.321617, "o", "device_type = host[\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m])\r\u001b[17d"]
[7511.322086, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Logged into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\r\u001b[18d"]
[7511.322476, "o", "output = net_connect.send_config_set(loopback_config.split(\u001b(B\u001b[0;1m\u001b[32m\"\\n\"\u001b[39m\u001b(B\u001b[m))\r\u001b[19d"]
[7511.322877, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Pushed config into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\r\u001b[20d"]
[7511.323306, "o", "net_connect.disconnect()\r\u001b[21d"]
[7511.323711, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Done!\"\u001b[39m\u001b(B\u001b[m)"]
