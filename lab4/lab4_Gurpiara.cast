[6697.801608, "o", "description = \u001b(B\u001b[0;1m\u001b[32m'Description set with Netmiko'\r\u001b[15d"]
[6697.802102, "o", "\u001b[39m\u001b(B\u001b[mdescription_config = [\u001b[16;5H"]
[6697.802516, "o", "\u001b(B\u001b[0;1m\u001b[32m\"interface GigabitEthernet3\"\u001b[39m\u001b(B\u001b[m,\u001b[17;5H"]
[6697.802969, "o", "f\u001b(B\u001b[0;1m\u001b[32m\"description {description}\"\r\u001b[18d"]
[6697.803379, "o", "\u001b[39m\u001b(B\u001b[m]\u001b[20d\b"]
[6697.803843, "o", "\u001b(B\u001b[0;1m\u001b[31m# New Loopback interface configuration commands\r\u001b[21d"]
[6697.804252, "o", "\u001b[39m\u001b(B\u001b[mloopback_config = [\u001b[22;5H"]
[6697.804869, "o", "\u001b(B\u001b[0;1m\u001b[32m\"interface Loopback0\"\u001b[39m\u001b(B\u001b[m,\u001b[23;5H"]
[6697.805325, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip address 10.10.10.1 255.255.255.0\"\u001b[39m\u001b(B\u001b[m,\u001b[24;5H"]
[6697.805733, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description Loopback interface configured by Netmiko\"\r\u001b[25d"]
[6697.806193, "o", "\u001b[39m\u001b(B\u001b[m]\u001b[27d\b"]
[6697.806604, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[28;5H"]
[6697.807043, "o", "net_connect = Netmiko(**device)\u001b[30;4H"]
[6697.807458, "o", "\u001b(B\u001b[0;1m\u001b[31m # Configure Loopback interface\u001b[31;5H"]
[6697.807952, "o", "\u001b[39m\u001b(B\u001b[mloopback_output = net_connect.send_config_set(loopback_config)\u001b[32;5H"]
[6697.808371, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Loopback configuration output on {device['ip']}:\\n{loopback_output}\"\u001b[39m\u001b(B\u001b[m)\u001b[34;4H"]
[6697.808806, "o", "\u001b(B\u001b[0;1m\u001b[31m # Configure GigabitEthernet3 description\u001b[35;5H"]
[6697.809206, "o", "\u001b[39m\u001b(B\u001b[mdescription_output = net_connect.send_config_set(description_config)\u001b[36;5H"]
[6697.809648, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Description configuration output on {device['ip']}:\\n{description_output}\"\u001b[39m\u001b(B\u001b[m)\u001b[38;5H"]
